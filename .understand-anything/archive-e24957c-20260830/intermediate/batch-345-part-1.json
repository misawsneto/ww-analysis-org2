      "id": "file:src-tauri/crates/app-platform/src/objc_bridge/objc_catch.m",
      "type": "file",
      "name": "objc_catch.m",
      "filePath": "src-tauri/crates/app-platform/src/objc_bridge/objc_catch.m",
      "summary": "Objective-C FFI trampoline that wraps a Rust callback in @try/@catch so NSExceptions raised by AppKit/WebKit calls don't unwind into and abort the Rust runtime; returns a heap-allocated error string when an exception is caught.",
      "tags": [
        "objective-c",
        "ffi",
        "error-handling",
        "macos",
        "native-bridge"
      ],
      "complexity": "simple",
      "languageNotes": "Rust cannot catch foreign (non-Rust) exceptions, so this file compiles to a C-ABI symbol Rust links against via FFI purely to catch NSExceptions before they cross into Rust frames."
    },
    {
      "id": "function:src-tauri/crates/app-platform/src/objc_bridge/objc_catch.m:orgii_objc_catch",
      "type": "function",
      "name": "orgii_objc_catch",
      "filePath": "src-tauri/crates/app-platform/src/objc_bridge/objc_catch.m",
      "lineRange": [
        29,
        45
      ],
      "summary": "Runs a Rust-supplied callback inside an Objective-C @try/@catch block, returning NULL on success or a malloc'd \"Name: reason\" C string when an NSException is caught.",
      "tags": [
        "ffi",
        "exception-handling",
        "objective-c"
      ],
      "complexity": "simple"
    },
