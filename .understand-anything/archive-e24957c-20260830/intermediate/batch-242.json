      "name": "connection.rs",
      "filePath": "src-tauri/crates/database/src/db/connection.rs",
      "summary": "Implements SQLite connection pooling and lifecycle management for orgii's two physical databases (sessions.db and projects.db), including WAL PRAGMA configuration, DB path resolution/legacy-file migration, and a registration-based schema-init dispatcher.",
      "tags": ["database", "sqlite", "connection-pool", "utility", "singleton"],
      "complexity": "complex",
      "languageNotes": "Uses OnceLock-based function-pointer dispatchers so this leaf crate can trigger schema init in the app crate without a direct dependency."
    },
