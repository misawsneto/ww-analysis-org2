      "name": "mod.rs",
      "filePath": "src-tauri/crates/database/src/db/mod.rs",
      "summary": "Module barrel for the db submodule that declares the connection and writer submodules and re-exports their public API (connection getters and writer-serialization helpers) for use by the crate root.",
      "tags": ["barrel", "module", "database", "re-export"],
      "complexity": "simple"
    },
    {
      "id": "file:src-tauri/crates/database/src/db/writer.rs",
      "type": "file",
      "name": "writer.rs",
      "filePath": "src-tauri/crates/database/src/db/writer.rs",
      "summary": "Provides process-wide SQLite writer serialization via a reentrant parking_lot mutex guard, preventing SQLITE_BUSY contention and busy_timeout exhaustion when multiple write transactions target sessions.db concurrently.",
      "tags": ["database", "sqlite", "concurrency", "mutex", "writer"],
      "complexity": "moderate",
      "languageNotes": "Uses a thread-local depth counter so nested with_sessions_writer closures on the same thread reuse the outer lock instead of deadlocking."
    },
