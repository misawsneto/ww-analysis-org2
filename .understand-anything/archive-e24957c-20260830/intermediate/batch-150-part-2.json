    {"id": "file:src-tauri/crates/agent-cli/src/generic_config.rs", "type": "file", "name": "generic_config.rs", "filePath": "src-tauri/crates/agent-cli/src/generic_config.rs", "summary": "Defines an allow-list of config files (path, format, base directory) for roughly 40 supported third-party coding CLI agents and exposes generic Tauri commands to get/read/write/reveal any of them safely.", "tags": ["config", "allow-list", "tauri-command", "validation"], "complexity": "complex", "languageNotes": "Uses a const fn constructor and a static allow-list table (ALLOWED_CLI_CONFIGS) as a data-driven registry instead of per-agent modules; safe_join guards against path traversal."},
