      "name": "MarkDownImpl.tsx",
      "filePath": "src/components/MarkDown/MarkDownImpl.tsx",
      "summary": "Implements the core markdown rendering component with syntax-highlighted code blocks, canvas-inline card support, in-repo file link resolution, and Mermaid diagram embedding; lazy-loaded from index.tsx to keep react-markdown/react-syntax-highlighter out of the initial bundle.",
