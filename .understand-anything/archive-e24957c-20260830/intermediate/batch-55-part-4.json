      "id": "file:src-tauri/crates/project-management/src/sync/conflict.rs",
      "type": "file",
      "name": "conflict.rs",
      "filePath": "src-tauri/crates/project-management/src/sync/conflict.rs",
      "summary": "Field-level conflict resolver: pure functions consumed by the merge cycle that decide per writable field whether to adopt the remote value, keep the local value, or delegate to the adapter's handle_conflict policy, given an ExternalChange, the local SyncMetadata revisions, and the adapter's declarative FieldMap.",
      "tags": [
        "sync",
        "conflict-resolution",
        "rust"
      ],
      "complexity": "moderate",
      "languageNotes": "No I/O happens here -- the merge cycle reads ResolverDecision::adopted_fields into a WorkItemPartialUpdate and ResolverDecision::new_revisions into apply_remote_merge, keeping this module pure and easily unit-testable."
    },
