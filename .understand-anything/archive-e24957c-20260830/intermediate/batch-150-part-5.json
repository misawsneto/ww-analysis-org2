    {"id": "file:src-tauri/crates/agent-cli/src/session_provenance.rs", "type": "file", "name": "session_provenance.rs", "filePath": "src-tauri/crates/agent-cli/src/session_provenance.rs", "summary": "Installs and manages ORGII's session-provenance hooks across 11 different coding-agent platforms (Claude Code, Codex, Cursor, QwenCode, Factory Droid, Trae, OpenCode, Windsurf, Kimi, Antigravity, ZCode) by idempotently patching each platform's own hook/plugin config format while preserving user-owned entries.", "tags": ["config", "hooks", "multi-platform", "state-machine"], "complexity": "complex", "languageNotes": "Each platform has its own hook config shape (nested JSON groups, flat arrays, TOML [[hooks]] tables, or a bundled plugin file); a marker string and fingerprint hash let the installer recognize and safely replace only its own managed entries."},

