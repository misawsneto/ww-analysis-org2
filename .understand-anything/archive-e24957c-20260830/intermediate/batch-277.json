      "id": "file:src/api/realtime/sseSchemas.ts",
      "type": "file",
      "name": "sseSchemas.ts",
      "filePath": "src/api/realtime/sseSchemas.ts",
      "summary": "Defines Zod schemas and typed parse helpers for the four Server-Sent Event payload shapes (start, output, end, error) emitted by the Rust IDE HTTP server.",
      "tags": ["validation", "schema-definition", "type-definition", "utility"],
      "complexity": "simple",
      "languageNotes": "Uses Zod v4 with .catchall(z.unknown()) to permit forward-compatible extra fields on end/error payloads, and z.output<> to derive TS types directly from the runtime schemas."
    },
    {
      "id": "file:src/api/realtime/sseStream.ts",
      "type": "file",
      "name": "sseStream.ts",
      "filePath": "src/api/realtime/sseStream.ts",
      "summary": "Low-level SSE client utility that opens an EventSource connection to the Rust HTTP server, validates each event payload via sseSchemas, and dispatches start/output/end/error callbacks with a returned cleanup function.",
      "tags": ["event-handler", "service", "utility", "streaming"],
      "complexity": "moderate"
    },
    {
