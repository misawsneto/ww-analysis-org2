      "name": "session.ts",
      "filePath": "src/types/session/session.ts",
      "summary": "Central type definitions and status-normalization helpers for the Session API, unifying CLI, Market, and Workflow session status models into a single 3-state (active/completed/failed) model mirrored from the Rust backend.",
