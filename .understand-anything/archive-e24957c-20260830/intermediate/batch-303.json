    {
      "id": "file:src/shared/dnd/dragSideChannel.ts",
      "type": "file",
      "name": "dragSideChannel.ts",
      "filePath": "src/shared/dnd/dragSideChannel.ts",
      "summary": "Window-scoped side-channel store for drag-and-drop state (internal file-tree drags, workstation tab drags, and time-limited PR/issue reference stashes) that lets React drag handlers communicate outside the standard HTML5 DataTransfer API.",
      "tags": ["drag-and-drop", "utility", "state-management", "shared"],
      "complexity": "moderate",
      "languageNotes": "Uses ad-hoc window globals as a same-window side channel to work around HTML5 DataTransfer's synchronous, read-restricted-during-dragover behavior; PR/issue stashes are TTL-guarded (30s) to avoid stale reference data leaking into unrelated drops."
    },
    {
      "id": "file:src/shared/dnd/referenceDragData.ts",
      "type": "file",
      "name": "referenceDragData.ts",
      "filePath": "src/shared/dnd/referenceDragData.ts",
      "summary": "Parses and normalizes PR/issue reference drag payloads from DataTransfer objects (or the side-channel stash) into typed pill data used to render reference chips during drag-and-drop.",
      "tags": ["drag-and-drop", "data-parsing", "validation", "utility"],
      "complexity": "moderate"
    },
    {
      "id": "file:src/shared/dnd/useReferencePillDrag.ts",
      "type": "file",
      "name": "useReferencePillDrag.ts",
      "filePath": "src/shared/dnd/useReferencePillDrag.ts",
      "summary": "React hook implementing pointer-based drag initiation for workstation tab \"reference pills\" (PR/issue pills), tracking a movement threshold, updating the side-channel drag state, dispatching custom tab-drag-start/tab-drag-end DOM events, and suppressing the trailing click after a completed drag.",
      "tags": ["react-hook", "drag-and-drop", "event-handling", "ui"],
      "complexity": "moderate",
      "languageNotes": "Generic hook parameterized over TElement extends HTMLElement so it can be reused across different pointer-down element types."
    },
