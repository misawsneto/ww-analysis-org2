      "name": "luminanceSampling.ts",
      "filePath": "src/hooks/theme/luminanceSampling.ts",
      "summary": "Pure helper functions for background-image luminance calculation (color parsing, canvas and Rust-accelerated region sampling, LRU cache) extracted from useRegionLuminance to keep the hook under its line limit.",
      "tags": ["utility", "image-processing", "caching", "performance", "theme"],
      "complexity": "complex",
      "languageNotes": "Combines a module-level Map used as a manual LRU cache with a Tauri invoke() call to a Rust command for 5-10x faster sampling, falling back to canvas-based per-region sampling in the browser."
    },
