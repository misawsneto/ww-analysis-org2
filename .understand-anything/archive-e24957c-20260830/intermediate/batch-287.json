      "name": "serviceAuthAtoms.ts",
      "filePath": "src/hooks/auth/serviceAuthAtoms.ts",
      "summary": "Defines the shared Jotai atoms backing global service-auth state (authenticated flag, token, expiry, error, loading/refreshing flags), plus a helper that clears both localStorage and the atoms atomically and a read-only hook for observing the state.",
      "tags": ["auth", "state-management", "jotai-atoms", "hook"],
      "complexity": "moderate",
      "languageNotes": "Uses Jotai's getDefaultStore() to imperatively write atom values outside of React component render, enabling synchronous auth-state clearing during logout."
    },
