      "filePath": "src/store/session/creatorDefaultModelAtom.ts",
      "summary": "Persists the session creator's last-used model+source pair per dispatch category (cli_agent / rust_agent) using a two-tier localStorage write-through cache plus authoritative settings.jsonc storage, so the SessionCreator can pre-fill a default selection on new sessions.",
      "tags": ["state-management", "jotai-atom", "persistence", "model-selection", "caching"],
      "complexity": "complex",
      "languageNotes": "Uses a module-level synchronous cachedMap seeded from localStorage so the derived read atom returns data before the async Rust-backed settings RPC resolves."
    },
