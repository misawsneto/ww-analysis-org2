      "name": "internal_browser_state.rs",
      "filePath": "src-tauri/crates/browser/src/internal_browser_state.rs",
      "summary": "Tracks which inline webview is the current 'active' internal browser target, bridging the frontend-owned webview lifecycle to Rust so agent tools can resolve the active browser without guessing from a generic session id.",
      "tags": [
        "state-management",
        "validation",
        "api-handler"
      ],
      "complexity": "complex"
    },
    {
      "id": "file:src-tauri/crates/browser/src/layering.rs",
      "type": "file",
      "name": "layering.rs",
      "filePath": "src-tauri/crates/browser/src/layering.rs",
      "summary": "Controls macOS NSView z-order (front/back layering) of inline webviews relative to sibling views such as the main React webview, since subview order determines both paint order and click-hit testing.",
      "tags": [
        "api-handler",
        "window-management",
        "platform-specific",
        "macos"
      ],
      "complexity": "moderate",
      "languageNotes": "On macOS, Tauri child webviews are sibling NSViews under the window's contentView; z-order and click routing follow NSView subview order rather than an explicit z-index property."
    },
    {
      "id": "file:src-tauri/crates/browser/src/lib.rs",
      "type": "file",
      "name": "lib.rs",
      "filePath": "src-tauri/crates/browser/src/lib.rs",
      "summary": "Crate root for the `browser` crate that declares and re-exports all browser/webview submodules (windows, inline, cookies, logging, DOM editing, scripts, types) as the crate's public API.",
      "tags": [
        "entry-point",
        "barrel",
        "crate-root"
