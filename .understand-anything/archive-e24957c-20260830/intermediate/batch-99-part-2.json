    },
    {
      "id": "file:src-tauri/crates/browser/src/logging.rs",
      "type": "file",
      "name": "logging.rs",
      "filePath": "src-tauri/crates/browser/src/logging.rs",
      "summary": "Captures console and network logs from inline webviews and implements element-inspection tooling (highlight, select, computed styles, DOM tree) backed by platform-specific JavaScript evaluation on WKWebView/WebView2.",
      "tags": [
        "api-handler",
        "logging",
        "devtools",
        "platform-specific"
      ],
      "complexity": "complex",
      "languageNotes": "Provides three cfg-gated implementations of `eval_js_with_result` (macOS via WKWebView, Windows via WebView2, and a not-yet-implemented fallback for other platforms) behind a single shared signature."
    },
